DATABASE_URL="postgresql://postgres:postgres@localhost:5432/training?schema=public"
# Optional but recommended for Prisma (non-pooled direct connection)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/training?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional: seed creates admin@example.com with this password (default: admin-admin-CHANGE)
ADMIN_SEED_PASSWORD="admin-admin-CHANGE"

# Email notifications (optional)
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` automatically.
# Other schedulers must send the same header. Min 16 chars.
CRON_SECRET="replace-with-random-token"
PUBLIC_BASE_URL="http://localhost:3000"

# Day boundary for the program/calendar (IANA zone). Default: Europe/Kyiv
APP_TIMEZONE="Europe/Kyiv"

# SMTP (required to actually send emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# Telegram bot (optional). Create a bot with @BotFather.
# TELEGRAM_WEBHOOK_SECRET: random 32+ chars; Telegram sends it back in a header on every update.
# After deploy run: npx tsx scripts/telegram-set-webhook.ts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
