{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/daily-email",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/telegram?slot=morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/telegram?slot=evening",
      "schedule": "0 17 * * *"
    }
  ]
}
